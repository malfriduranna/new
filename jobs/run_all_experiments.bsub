#!/bin/bash
#BSUB -J action-exp
#BSUB -q gpul40s
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -W 08:00
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=8GB]"
#BSUB -M 8GB
#BSUB -o logs/%J.out
#BSUB -e logs/%J.err

set -euo pipefail

module purge
unset PYTHONHOME || true
unset PYTHONPATH || true

REPO="$HOME/new"
VENV="$REPO/.venv"
CONFIG="$REPO/configs/experiments.yaml"
PY="$VENV/bin/python"
PIP="$VENV/bin/pip"
DEPS_SENTINEL="$VENV/.deps_installed"
mkdir -p "$REPO/logs"
LOG_ID=${LSB_JOBID:-manual}
RUN_LOG="$REPO/logs/${LOG_ID}_run.log"
touch "$RUN_LOG"
exec > >(tee -a "$RUN_LOG") 2>&1

cd "$REPO"

echo "=== START $(date) on $(hostname) ==="
echo "[env] repo: $(pwd)"
echo "[env] venv: $VENV"

if [ ! -x "$PY" ]; then
  echo "[env] creating venv"
  python3 -m venv "$VENV"
fi

echo "[env] activating venv"
source "$VENV/bin/activate"
if [ ! -f "$DEPS_SENTINEL" ]; then
  echo "[env] installing deps"
  $PIP install --upgrade pip
  $PIP install -r requirements.txt
  touch "$DEPS_SENTINEL"
else
  echo "[env] deps already installed, skipping pip install"
fi

echo "[run] Exp 1 - modality comparison"
$PY -m experiments.exp1_modality --config "$CONFIG"

echo "[run] Exp 2 - data efficiency"
$PY -m experiments.exp2_efficiency --config "$CONFIG"

echo "[run] Exp 3 - semantic grouping"
$PY -m experiments.exp3_semantic --config "$CONFIG"

echo "[run] Exp 4 - robustness"
$PY -m experiments.exp4_robustness --config "$CONFIG"

echo "[run] Exp 5 - late fusion"
$PY -m experiments.exp5_fusion --config "$CONFIG"

echo "=== END $(date) ==="
