#!/bin/bash
#BSUB -J action-exp-pretrained
#BSUB -q gpul40s
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -W 04:00
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=8GB]"
#BSUB -M 8GB
#BSUB -o logs/%J.out
#BSUB -e logs/%J.err

set -euo pipefail

module purge
unset PYTHONHOME || true
unset PYTHONPATH || true

REPO="$HOME/new"
VENV="${VENV_PATH:-$REPO/.venv}"
CONFIG="$REPO/configs/experiments.yaml"
PY="$VENV/bin/python"
DEPS_SENTINEL="$VENV/.deps_installed"
OUTPUT_ROOT="${OUTPUT_ROOT:-$REPO/outputs}"
export ACTION_EXP_OUTPUT_ROOT="$OUTPUT_ROOT"
mkdir -p "$REPO/logs"
mkdir -p "$OUTPUT_ROOT"
LOG_ID=${LSB_JOBID:-manual}
RUN_LOG="$REPO/logs/${LOG_ID}_run.log"
touch "$RUN_LOG"
exec > >(tee -a "$RUN_LOG") 2>&1

cd "$REPO"

echo "=== START $(date) on $(hostname) ==="
echo "[env] repo: $(pwd)"
echo "[env] venv: $VENV"

if [ ! -x "$PY" ]; then
  echo "[env] creating venv"
  python3 -m venv "$VENV"
fi

echo "[env] activating venv"
source "$VENV/bin/activate"
if [ ! -f "$DEPS_SENTINEL" ]; then
  echo "[env] ERROR: dependencies not installed. Run scripts/setup_cluster_env.sh on a login node first."
  exit 1
fi

echo "[info] VideoMAE settings:"
python - <<'PY'
import yaml
from pathlib import Path
config = yaml.safe_load(Path("$CONFIG").read_text())
vm = config["base"]["videomae"]
print(f"  model_name_or_path: {vm.get('model_name_or_path', 'MCG-NJU/videomae-base')}")
print(f"  eval_only: {vm.get('eval_only', False)}")
PY

echo "[run] Exp 1 - modality comparison (VideoMAE eval-only)"
$PY -m experiments.exp1_modality --config "$CONFIG"

echo "=== END $(date) ==="
